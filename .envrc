# direnv — per-project env for this workspace. Run `direnv allow` once after editing.
#
# gh IDENTITY ISOLATION (opt-in, UL-0007): if .claude/gh-identity declares a GitHub account,
# pin gh's config dir to that account's isolated ~/.config/gh-<account> so a multi-account
# operator never runs gh as the wrong identity here. Single-account adopters can leave
# .claude/gh-identity absent — the guard hook stays dormant. A NESTED repo that is its own
# project with a different account gets its own .envrc (use `source_up` there, then override).
if [ -f .claude/gh-identity ]; then
  _gh_acct="$(tr -d '[:space:]' < .claude/gh-identity)"
  [ -n "$_gh_acct" ] && export GH_CONFIG_DIR="$HOME/.config/gh-$_gh_acct"
  unset _gh_acct
fi

# Foundry operator identity (FOUNDRY_* namespace). FOUNDRY_OPERATOR is the active operator id the
# authz/merge gate resolves against the committed .claude/foundry-operators.json — set it to a key
# present in that registry (replace the placeholder).
export FOUNDRY_OPERATOR="op_example"
